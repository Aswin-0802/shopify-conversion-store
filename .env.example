# Session cookie signing. Use a long random string in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# Shopify storefront connection
# After linking, run: npx shopify hydrogen env pull
PUBLIC_STORE_DOMAIN="your-store.myshopify.com"
PUBLIC_STOREFRONT_API_TOKEN=""
PRIVATE_STOREFRONT_API_TOKEN=""
PUBLIC_STOREFRONT_ID=""
PUBLIC_CHECKOUT_DOMAIN="your-store.myshopify.com"

# Customer Account API
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""

# Judge.me reviews (optional, recommended)
# Use your shop's myshopify.com domain. Do not put private API keys here.
PUBLIC_JUDGEME_SHOP_DOMAIN=""

# Optional form endpoints (Formspree, Klaviyo, Mailchimp, Basin, etc.)
CONTACT_FORM_ENDPOINT=""
NEWSLETTER_FORM_ENDPOINT=""
